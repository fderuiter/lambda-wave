#!/usr/bin/env bash
set -e

# Regex pattern for forbidden files
REGEX="scratchpad|\.todo$|^todo\.txt$|^tasks\.md$|^scratchpad\.md$|~$|\.bak$|\.swp$|^\.vscode/|^\.idea/|^cabal\.project\.local$|^\.cabal-sandbox/"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FORBIDDEN_FOUND=0
for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -Eq "$REGEX"; then
        echo "Error: Attempting to commit a forbidden file: $FILE"
        echo "This file matches local workspace exclusion patterns."
        FORBIDDEN_FOUND=1
    fi
done

if [ "$FORBIDDEN_FOUND" -eq 1 ]; then
    exit 1
fi

exit 0
