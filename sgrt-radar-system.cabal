cabal-version: 2.2

name:           sgrt-radar-system
version:        0.1.0.0
description:    Safety-critical Surface Guided Radiation Therapy (SGRT) system
author:         Frederick de Ruiter, Ayoola Okuribido
maintainer:     Frederick de Ruiter <fpderuiter@gmail.com>
copyright:      2024-2026 Frederick de Ruiter, Ayoola Okuribido
license:        AGPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    cbits/include/*.h

common common-options
  default-extensions:
      OverloadedStrings
      StrictData
      NumericUnderscores
      CPP
  if flag(sandbox)
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
    cpp-options: -DSANDBOX
  else
    ghc-options: -Wall -Werror -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base ==4.17.2.1
    , stm ==2.5.1.0
    , binary ==0.8.9.1
    , bytestring ==0.11.5.3
    , unix ==2.7.3
    , deepseq ==1.4.8.0
    , containers ==0.6.7
    , filepath ==1.4.2.2
    , network ==3.2.8.0
  default-language: Haskell2010

flag enable-ui
  description: Enable OpenGL UI
  manual: True
  default: False

flag enable-web-ui
  description: Enable Web UI
  manual: True
  default: False

flag sandbox
  description: Enable Sandbox mode with relaxed compiler rules
  manual: True
  default: False

library
  import: common-options
  exposed-modules:
      Control.Gating
      Control.Mesher
      Data.Config
      Data.Types
      Data.Time.HighRes
      FFI.RingBuffer.IO
      FFI.RingBuffer.Types
      Hardware.Control
      Hardware.Consumer
      Hardware.Integrity
      Hardware.Types
      Safety.Audit
      Safety.Watchdog
      SignalProcessing.FMCW
      SignalProcessing.Regression
      SignalProcessing.Kalman
      Numeric.Simple
      Numeric.Kinematics
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      src
  include-dirs:
      cbits/include
  cxx-sources:
      cbits/src/RingBufferCheck.cpp
      cbits/src/ring_buffer.cpp
      cbits/src/serial_config.cpp
      cbits/src/gpio_driver.cpp
  cc-options: -Wall -O2
  cxx-options: -std=c++11 -Wall -O2
  extra-libraries: stdc++

executable sgrt-radar-system-exe
  import: common-options
  main-is: Main.hs
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  extra-libraries: stdc++
  build-depends:
      sgrt-radar-system

executable sgrt-visualizer-exe
  import: common-options
  main-is: VisualizerMain.hs
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system

  if flag(enable-ui)
    build-depends:
        GLUT ==2.7.0.16
      , OpenGL ==3.0.3.0
    cpp-options: -DENABLE_UI
    other-modules:
        Control.UI.Renderer
        Control.UI.Window
        Control.UI.Input

  if flag(enable-web-ui)
    build-depends:
        wai
      , warp
      , websockets
      , wai-websockets
      , aeson ==2.2.5.0
      , text ==2.0.2
      , http-types
      , file-embed
    cpp-options: -DENABLE_WEB_UI
    other-modules:
        Control.WebUI
        Control.WebUI.Types

executable watchdog-fault
  import: common-options
  main-is: WatchdogFault.hs
  hs-source-dirs:
      test/Safety
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , base ==4.17.2.1
    , stm ==2.5.1.0
    , containers ==0.6.7
    , unix ==2.7.3

