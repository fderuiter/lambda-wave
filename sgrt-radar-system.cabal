cabal-version: 2.2

name:           sgrt-radar-system
version:        0.1.0.0
description:    Safety-critical Surface Guided Radiation Therapy (SGRT) system
author:         Frederick de Ruiter, Ayoola Okuribido
maintainer:     Frederick de Ruiter <fpderuiter@gmail.com>
copyright:      2024-2026 Frederick de Ruiter, Ayoola Okuribido
license:        AGPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    cbits/include/*.h

common common-options
  default-extensions:
      OverloadedStrings
      StrictData
      NumericUnderscores
      CPP
  ghc-options: -Wall -Werror -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , stm
    , binary
    , bytestring
    , unix
    , deepseq
    , containers
    , filepath
    , network
  default-language: Haskell2010

flag enable-ui
  description: Enable OpenGL UI
  manual: True
  default: False

flag enable-web-ui
  description: Enable Web UI
  manual: True
  default: False

library
  import: common-options
  exposed-modules:
      Control.Gating
      Control.Mesher
      Data.Config
      Data.Types
      Data.Time.HighRes
      FFI.RingBuffer.IO
      FFI.RingBuffer.Types
      Hardware.Control
      Hardware.Consumer
      Hardware.Types
      Safety.Audit
      Safety.Watchdog
      SignalProcessing.FMCW
      SignalProcessing.Regression
      SignalProcessing.Kalman
      Numeric.Simple
      Numeric.Kinematics
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      src
  include-dirs:
      cbits/include
  cxx-sources:
      cbits/src/RingBufferCheck.cpp
      cbits/src/ring_buffer.cpp
      cbits/src/serial_config.cpp
  cc-options: -Wall -O2
  cxx-options: -std=c++11 -Wall -O2
  extra-libraries: stdc++

executable sgrt-radar-system-exe
  import: common-options
  main-is: Main.hs
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  extra-libraries: stdc++
  build-depends:
      sgrt-radar-system

  if flag(enable-ui)
    build-depends:
        GLUT
      , OpenGL
    cpp-options: -DENABLE_UI
    other-modules:
        Control.UI.Renderer
        Control.UI.Window
        Control.UI.Input

executable sgrt-visualizer-exe
  import: common-options
  main-is: VisualizerMain.hs
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system

  if flag(enable-ui)
    build-depends:
        GLUT
      , OpenGL
    cpp-options: -DENABLE_UI
    other-modules:
        Control.UI.Renderer
        Control.UI.Window
        Control.UI.Input

  if flag(enable-web-ui)
    build-depends:
        wai
      , warp
      , websockets
      , wai-websockets
      , aeson
      , text
      , http-types
      , file-embed
    cpp-options: -DENABLE_WEB_UI
    other-modules:
        Control.WebUI
        Control.WebUI.Types

