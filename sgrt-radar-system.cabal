  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_sgrt_radar_system
      FFI.RingBuffer.TypesSpec
      FFI.RingBuffer.IOSpec
      RegressionSpec
      Control.MesherSpec
      Hardware.ConsumerSpec
      Hardware.ControlSpec
      System.RTSSpec
      SignalProcessing.FMCWSpec
      Safety.WatchdogSpec
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , hspec ==2.11.17
    , QuickCheck ==2.18.0.0
    , bytestring ==0.11.5.3
    , binary ==0.8.9.1

