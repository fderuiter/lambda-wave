cabal-version: 2.2
-- Requirement SR-SOUP-001

name:           sgrt-radar-system
version:        0.1.0.0
description:    Safety-critical Surface Guided Radiation Therapy (SGRT) system
author:         Frederick de Ruiter, Ayoola Okuribido
maintainer:     Frederick de Ruiter <fpderuiter@gmail.com>
copyright:      2024-2026 Frederick de Ruiter, Ayoola Okuribido
license:        AGPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    cbits/include/*.h

common common-options
  default-extensions:
      OverloadedStrings
      StrictData
      NumericUnderscores
      CPP
  if flag(sandbox)
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wno-missing-home-modules -Wpartial-fields -Wredundant-constraints
    cpp-options: -DSANDBOX
  else
    ghc-options: -Wall -Werror -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wno-missing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >= 4.16 && < 5
    , stm ==2.5.1.0
    , binary ==0.8.9.1
    , bytestring ==0.11.5.3
    , unix >=2.7 && <2.9
    , template-haskell
    , deepseq >=1.4.8.0 && <1.5
    , containers ==0.6.7
    , filepath >=1.4.2.2 && <1.5
    , network ==3.2.8.0
    , crypton
    , memory
    , time
    , directory
    , aeson
    , text
    , unordered-containers
    , stm
  default-language: Haskell2010


flag sandbox
  description: Enable Sandbox mode with relaxed compiler rules
  manual: True
  default: False


library sgrt-radar-math
  import: common-options
  exposed-modules:
      Safety.Result
      SignalProcessing.FMCW
      SignalProcessing.Matrix
      SignalProcessing.Regression
      SignalProcessing.Kalman
      Numeric.Kinematics
      Numeric.Simple
      Numeric.Units

  hs-source-dirs:
      src-math
  build-depends:
      base >= 4.16 && < 5
    , binary ==0.8.9.1
    , deepseq >=1.4.8.0 && <1.5

library
  import: common-options
  build-depends:
    sgrt-radar-math
  exposed-modules:

      Control.Gating
      Control.Mesher
      Data.Config
      Data.Types
      Data.Time.HighRes
      Data.I18n
      FFI.RingBuffer.IO
      FFI.RingBuffer.Types
      FFI.Hud.Types
      FFI.RingBuffer.Generated
      Hardware.Control
      Hardware.FFI.Bridge
      Hardware.Consumer
      Hardware.FFI.Common
      Hardware.Manifest
      Hardware.Types
      Safety.Audit
      Safety.Crypto
      Safety.Thread
      Safety.Token
      Safety.Verification
      Safety.Watchdog
      UI.Presentation
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      src
  include-dirs:
      cbits/include
  install-includes:
      a11y_bridge.h
  cxx-sources:
      cbits/src/RingBufferCheck.cpp
      cbits/src/ring_buffer.cpp
      cbits/src/ring_buffer_ffi.cpp
      cbits/src/serial_config.cpp
      cbits/src/gpio_driver.cpp
      cbits/src/hud.cpp
      cbits/src/a11y_bridge.cpp
      cbits/imgui/imgui.cpp
      cbits/imgui/imgui_draw.cpp
      cbits/imgui/imgui_tables.cpp
      cbits/imgui/imgui_widgets.cpp
      cbits/imgui/backends/imgui_impl_glfw.cpp
      cbits/imgui/backends/imgui_impl_opengl3.cpp
  cc-options: -Wall -O2
  cxx-options: -std=c++11 -Wall -O2 -I cbits/imgui
  extra-libraries: stdc++ glfw GLEW GL

executable sgrt-radar-system-exe
  import: common-options
  main-is: Main.hs
  other-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  extra-libraries: stdc++
  build-depends:
      sgrt-radar-system
    , sgrt-radar-math
    , process

