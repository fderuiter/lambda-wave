      RegressionSpec
      Control.MesherSpec
      Hardware.ConsumerSpec
      Hardware.ControlSpec
      System.RTSSpec
      SignalProcessing.FMCWSpec
      Safety.WatchdogSpec
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , hspec
    , QuickCheck
    , bytestring
    , binary

