cabal-version: 2.2

name:           sgrt-radar-system
version:        0.1.0.0
description:    Safety-critical Surface Guided Radiation Therapy (SGRT) system
author:         Frederick de Ruiter, Ayoola Okuribido
maintainer:     Frederick de Ruiter <fpderuiter@gmail.com>
copyright:      2024-2026 Frederick de Ruiter, Ayoola Okuribido
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    cbits/include/*.h

common common-options
  default-extensions:
      OverloadedStrings
      StrictData
      NumericUnderscores
      CPP
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , stm
    , binary
    , bytestring
    , unix
    , deepseq
    , containers
  default-language: Haskell2010

library
  import: common-options
  exposed-modules:
      Control.Gating
      Control.Mesher
      Data.Config
      Data.Types
      Data.Time.HighRes
      FFI.RingBuffer.IO
      FFI.RingBuffer.Types
      Hardware.Control
      Hardware.Consumer
      Safety.Audit
      Safety.Watchdog
      SignalProcessing.FMCW
      SignalProcessing.Regression
      SignalProcessing.Kalman
      Numeric.Simple
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      src
  include-dirs:
      cbits/include
  cxx-sources:
      cbits/src/RingBufferCheck.cpp
      cbits/src/ring_buffer.cpp
  cc-options: -Wall -O2
  cxx-options: -std=c++11 -Wall -O2
  extra-libraries: stdc++

executable sgrt-radar-system-exe
  import: common-options
  main-is: Main.hs
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  extra-libraries: stdc++
  build-depends:
      sgrt-radar-system

test-suite sgrt-radar-system-test
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_sgrt_radar_system
      FFI.RingBuffer.TypesSpec
      FFI.RingBuffer.IOSpec
      RegressionSpec
      Hardware.ConsumerSpec
      Hardware.ControlSpec
      System.RTSSpec
      SignalProcessing.FMCWSpec
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , hspec
    , QuickCheck
    , bytestring
    , binary

test-suite kalman-verification
  import: common-options
  type: exitcode-stdio-1.0
  main-is: KalmanCheck.hs
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      test/SignalProcessing
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , base

benchmark sgrt-radar-system-bench
  import: common-options
  type: exitcode-stdio-1.0
  main-is: LatencyBench.hs
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      bench
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      sgrt-radar-system
    , criterion

test-suite gating-check
  import: common-options
  type: exitcode-stdio-1.0
  main-is: GatingCheck.hs
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      test/Control
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -qa -l"
  build-depends:
      sgrt-radar-system
    , base

benchmark kalman-bench
  import: common-options
  type: exitcode-stdio-1.0
  main-is: KalmanBench.hs
  other-modules:
      Paths_sgrt_radar_system
  autogen-modules:
      Paths_sgrt_radar_system
  hs-source-dirs:
      bench
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      sgrt-radar-system
    , criterion
